{
  "name": "digital-identity-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PATH=\"$PWD/.tools/bin:$PATH\" NEXT_TEST_WASM_DIR=\"$PWD/node_modules/@next/swc-wasm-nodejs\" next dev --webpack",
    "build": "PATH=\"$PWD/.tools/bin:$PATH\" NEXT_TEST_WASM_DIR=\"$PWD/node_modules/@next/swc-wasm-nodejs\" next build --webpack",
    "start": "PATH=\"$PWD/.tools/bin:$PATH\" NEXT_TEST_WASM_DIR=\"$PWD/node_modules/@next/swc-wasm-nodejs\" next start",
    "db:generate": "PATH=\"$PWD/.tools/bin:$PATH\" prisma generate",
    "db:push": "PATH=\"$PWD/.tools/bin:$PATH\" prisma db push",
    "db:init-sqlite": "sqlite3 prisma/dev.sqlite < scripts/init-ads-sqlite.sql",
    "db:migrate-sqlite": "sqlite3 prisma/dev.sqlite < scripts/migrate-ads-sqlite.sql",
    "ads:seed": "PATH=\"$PWD/.tools/bin:$PATH\" node scripts/ads-seed.mjs",
    "ads:import": "PATH=\"$PWD/.tools/bin:$PATH\" node scripts/ads-import.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib store --max-warnings=0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@types/pdfkit": "^0.17.6",
    "framer-motion": "^12.23.24",
    "gsap": "^3.13.0",
    "lenis": "^1.3.13",
    "lucide-react": "^0.554.0",
    "next": "^16.0.7",
    "pdfkit": "^0.18.0",
    "prisma": "^6.19.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.181.2",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.0.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.7",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
